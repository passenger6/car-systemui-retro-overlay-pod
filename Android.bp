package {
    default_applicable_licenses: ["CarSystemUI-Retro-Overlay_license"],
}

license {
    name: "CarSystemUI-Retro-Overlay_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

android_library {
    name: "CarSystemUI-Retro-Overlay",
    srcs: [
        "src/**/*.kt",
    ],
    static_libs: [
        "CarSystemUI-Shared",
    ],
    resource_dirs: [
        "res",
    ],
    plugins: ["dagger2-compiler"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
