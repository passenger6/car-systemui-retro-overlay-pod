package {
    default_applicable_licenses: ["CarSystemUI-Retro-Overlay_license"],
}

// The DEWD landscape reference layout plus the retro overlay panel. The panels of the reference
// come in as a resource library (dewd-land-res-base carries app_panel, map_panel, widget_panel
// and, through dewd-res-common, the bars and the HUN); only window_states and the two retro
// files live here, so the sample stays a diff against the reference, not a copy of it.
runtime_resource_overlay {
    name: "RetroOverlayRRO",
    resource_dirs: ["res"],
    certificate: "platform",
    manifest: "AndroidManifest.xml",
    system_ext_specific: true,
    static_libs: [
        "dewd-land-res-base",
        "com_android_car_scalableui_flags_lib",
    ],
    flags_packages: ["com_android_car_scalableui_flags"],
}
