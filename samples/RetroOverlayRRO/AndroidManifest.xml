<!-- Not static: enabled by hand with `cmd overlay enable`, so it can sit next to the static
     DEWD reference overlay (priority 200) and win over it while it is on. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.android.systemui.rro.retro">
    <application android:hasCode="false" />
    <overlay
        android:targetPackage="com.android.systemui"
        android:isStatic="false"
        android:priority="300"
         />
</manifest>
