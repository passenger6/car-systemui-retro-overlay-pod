<!-- The whole-display overlay: on from boot, spans the display, layer 101 (above the task
     panels at 100, below the assistant at 200). `retro_on` / `retro_off` toggle it. -->
<DecorPanel id="retro_screen" defaultVariant="@id/on" displayId="0" controller="@xml/retro_screen_controller">
    <Variant id="@+id/base">
        <Layer layer="101"/>
        <Bounds left="0" top="0" width="100%" height="100%"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/on" parent="@id/base">
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
    </Variant>
    <Variant id="@+id/off" parent="@id/base">
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
    </Variant>
    <Transitions>
        <Transition onEvent="retro_on" toVariant="@id/on" duration="0"/>
        <Transition onEvent="retro_off" toVariant="@id/off" duration="0"/>
    </Transitions>
</DecorPanel>
